# Copy to secrets.toml (same directory) and fill in real values for
# local development. NEVER commit secrets.toml — it's listed in
# .gitignore at the repo root. For Streamlit Community Cloud, paste
# the contents of this file (with real values) into the Secrets UI
# at Settings → Secrets.
#
# The service-role key is required because public.plays has no anon
# SELECT policy. The key bypasses RLS, so it must never reach the
# browser — Streamlit Cloud injects it server-side only.

[supabase]
url = "https://<project-ref>.supabase.co"
service_role_key = "eyJhbGciOi...replace-me..."
